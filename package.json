{
  "name": "x3-linkedlist",
  "version": "1.2.0",
  "description": "A doubly linked list implementation",
  "keywords": [
    "linkedlist",
    "array",
    "iterator",
    "list",
    "linked",
    "doublelinked"
  ],
  "homepage": "https://github.com/x3cion/x3-linkedlist",
  "bugs": {
    "url": "https://github.com/x3cion/x3-linkedlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3cion/x3-linkedlist.git"
  },
  "license": "MIT",
  "author": "Benno Dreißig",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./LinkedList": {
      "types": "./dist/LinkedList.d.ts",
      "default": "./dist/LinkedList.js"
    },
    "./LinkedListItem": {
      "types": "./dist/LinkedListItem.d.ts",
      "default": "./dist/LinkedListItem.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist/ && tsc",
    "doc": "rimraf docs/typedoc && typedoc src/",
    "full": "pnpm run lint && pnpm run build && pnpm run test && pnpm run doc",
    "lint": "eslint --fix .",
    "prepublishOnly": "pnpm run full",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsonc": "^2.18.2",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=18.12.0"
  }
}
