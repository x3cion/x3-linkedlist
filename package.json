{
  "name": "x3-linkedlist",
  "version": "1.2.0",
  "description": "A doubly linked list implementation",
  "keywords": [
    "linkedlist",
    "array",
    "iterator",
    "list",
    "linked",
    "doublelinked"
  ],
  "homepage": "https://github.com/x3cion/x3-linkedlist",
  "bugs": {
    "url": "https://github.com/x3cion/x3-linkedlist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x3cion/x3-linkedlist.git"
  },
  "license": "MIT",
  "author": "Benno Dreißig",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:clean": "rimraf dist/",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "doc": "rimraf docs/typedoc && typedoc src/",
    "full": "npm run lint && npm run build && npm run test && npm run doc",
    "lint": "eslint --fix .",
    "prepublishOnly": "npm run full",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "watch": "tsc -p tsconfig.esm.json -w"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-jsonc": "^2.18.2",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=18.12.0"
  }
}
